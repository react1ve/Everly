<?xml version="1.0" encoding="utf-8"?>
<!-- Firebase reads these generated strings by name at runtime; keep them through resource shrinking
     (the google-services plugin would normally add this). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/google_app_id,@string/google_api_key,@string/google_crash_reporting_api_key,@string/gcm_defaultSenderId,@string/project_id,@string/google_storage_bucket,@string/default_web_client_id" />
